# App connection (role hrms_app, row-level security enforced)
DATABASE_URL=postgres://hrms_app:CHANGE_ME@localhost:5432/hrms
# Owner connection, used only by scripts/migrate.mjs and scripts/seed-demo.mjs
MIGRATE_DATABASE_URL=postgres://hrms_owner:CHANGE_ME@localhost:5432/hrms
# 32 random bytes, base64. Encrypts PAN, Aadhaar and bank account numbers. Losing it loses that data.
DATA_KEY=
# Set to "off" only for a local database without TLS
DATABASE_SSL=require
