generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// USER & AUTHENTICATION
// --------------------------------------------------------

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  PAYROLL_ADMIN
  MANAGER
  EMPLOYEE
  AUDITOR
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String 
  role          Role      @default(EMPLOYEE)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee      Employee?
  audits        AuditLog[]
  lockedBatches AttendanceLedger[] @relation("BatchLocker")
}

// --------------------------------------------------------
// MASTER DATA
// --------------------------------------------------------

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  code      String     @unique
  employees Employee[]
}

model Location {
  id        String     @id @default(uuid())
  name      String     @unique
  address   String?
  employees Employee[]
}

model ShiftMaster {
  id                String   @id @default(uuid())
  name              String   @unique
  startTime         DateTime // 1970-01-01 T...
  endTime           DateTime
  lateGraceMinutes  Int      @default(15)
  earlyExitGrace    Int      @default(15)
  halfDayThreshold  Int      @default(240) 
  fullDayThreshold  Int      @default(480) 
  otThreshold       Int      @default(60)  
  isNightShift      Boolean  @default(false)
  
  employees         Employee[]
  attendanceLedgers AttendanceLedger[]
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique
  name      String
  isOptional Boolean @default(false)
  locationId String? // Optional: Holiday specific to location
}

// --------------------------------------------------------
// CONFIGURATION ENGINE (Policy & Rules)
// --------------------------------------------------------

model PolicyConfig {
  id                      String   @id @default(uuid())
  effectiveFrom           DateTime @default(now())
  
  sandwichRuleEnabled     Boolean  @default(true)
  
  // Comp-Off Rules
  compOffMinWorkMinutes   Int      @default(300) // 5 Hours
  compOffValidityDays     Int      @default(90)
  
  // Late Rules
  lateDeductionEnabled    Boolean  @default(false)
  lateLimitPerMonth       Int      @default(3)
  latePenaltyLeaveTypeId  String?  // Which leave to deduct?
  
  createdAt               DateTime @default(now())
}

model LeaveType {
  id                    String   @id @default(uuid())
  name                  String   @unique // CL, SL, EL
  description           String?
  
  // Accrual Logic
  accrualType           AccrualType @default(MONTHLY) // YEARLY, MONTHLY
  accrualValue          Float       // e.g., 1.5 per month
  
  // Carry Forward Logic
  carryForwardEnabled   Boolean     @default(false)
  maxCarryForward       Float       @default(0)
  
  // Rules
  requiresApproval      Boolean     @default(true)
  allowNegativeBalance  Boolean     @default(false)
  
  ledgers               LeaveLedger[]
  requests              LeaveRequest[]
}

enum AccrualType {
  MONTHLY
  YEARLY
  QUARTERLY
  NONE // Manual
}

// --------------------------------------------------------
// EMPLOYEE PROFILE (Hierarchy)
// --------------------------------------------------------

model Employee {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String   @unique
  
  empCode       String   @unique
  firstName     String
  lastName      String
  designation   String
  
  department    Department @relation(fields: [departmentId], references: [id])
  departmentId  String
  
  location      Location   @relation(fields: [locationId], references: [id])
  locationId    String
  
  shift         ShiftMaster @relation(fields: [shiftId], references: [id])
  shiftId       String

  // Hierarchy (Recursive)
  manager       Employee?  @relation("ManagerTeam", fields: [managerId], references: [id])
  managerId     String?
  team          Employee[] @relation("ManagerTeam")
  
  joiningDate   DateTime
  
  // Relations
  attendance    AttendanceLedger[]
  leaveBalance  LeaveLedger[]
  leaveRequests LeaveRequest[]
  compOffs      CompOffLedger[]
}

// --------------------------------------------------------
// ATTENDANCE CORE (IMMUTABLE)
// --------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  WEEKLY_OFF
  HOLIDAY
  LWP
}

enum AttendanceFlag {
  NORMAL
  MISSING_PUNCH
  MANUAL_OVERRIDE
  AUTO_CORRECTED
}

model AttendanceLedger {
  id                String           @id @default(uuid())
  employee          Employee         @relation(fields: [employeeId], references: [id])
  employeeId        String
  
  date              DateTime         
  shift             ShiftMaster      @relation(fields: [shiftId], references: [id])
  shiftId           String
  
  punchIn           DateTime?
  punchOut          DateTime?
  
  status            AttendanceStatus
  flag              AttendanceFlag   @default(NORMAL)
  
  lateMinutes       Int              @default(0)
  earlyExitMinutes  Int              @default(0)
  otMinutes         Int              @default(0)
  workMinutes       Int              @default(0)
  
  // Immutability
  version           Int              @default(1)
  isActive          Boolean          @default(true)
  processedAt       DateTime         @default(now())
  batchId           String?          
  
  // Payroll Lock
  isLocked          Boolean          @default(false)
  lockedBy          User?            @relation("BatchLocker", fields: [lockedById], references: [id])
  lockedById        String?
  lockedAt          DateTime?

  @@index([employeeId, date, isActive])
  @@index([date, status])
}

// --------------------------------------------------------
// LEAVE & COMP-OFF ENGINE
// --------------------------------------------------------

model LeaveLedger {
  id            String    @id @default(uuid())
  employee      Employee  @relation(fields: [employeeId], references: [id])
  employeeId    String
  
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  leaveTypeId   String
  
  year          Int
  
  openingBalance Float    @default(0)
  accrued        Float    @default(0)
  used           Float    @default(0)
  closingBalance Float    @default(0)
  
  updatedAt     DateTime  @updatedAt
  
  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  employee    Employee    @relation(fields: [employeeId], references: [id])
  employeeId  String
  
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  leaveTypeId String
  
  startDate   DateTime
  endDate     DateTime
  daysCount   Float
  reason      String
  
  status      LeaveStatus @default(PENDING)
  
  approvedBy  String?     
  approvedAt  DateTime?
  rejectionReason String?
  
  createdAt   DateTime    @default(now())
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model CompOffLedger {
  id            String    @id @default(uuid())
  employee      Employee  @relation(fields: [employeeId], references: [id])
  employeeId    String

  dateEarned    DateTime
  workMinutes   Int
  expiryDate    DateTime
  
  isUsed        Boolean   @default(false)
  usedDate      DateTime?
  
  createdAt     DateTime  @default(now())
}

// --------------------------------------------------------
// AUDIT LOGGING
// --------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // CREATE, UPDATE, LOCK
  entity      String   
  entityId    String
  
  performedBy User?    @relation(fields: [userId], references: [id])
  userId      String?
  
  timestamp   DateTime @default(now())
  
  oldValue    Json?    
  newValue    Json?    
  
  ipAddress   String?
  userAgent   String?
}
